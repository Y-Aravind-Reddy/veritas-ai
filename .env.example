# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase Configuration
# Required for connecting the frontend to your Supabase project (Auth, Realtime, DB)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# Server/Edge Function Secret (Never expose in client code)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# n8n AI Agent Webhook Integration
# The URL of the n8n webhook workflow developed by your teammate
N8N_WEBHOOK_URL="https://n8n.your-domain.com/webhook/veritas-investigate"
N8N_WEBHOOK_TOKEN="your-shared-n8n-bearer-token"
N8N_CALLBACK_SECRET="veritas-n8n-callback-secret-key"
